{
  "name": "@matheussartori/hackerchat-client",
  "version": "1.0.3",
  "description": "The hackerchat client allows you to connect to any hackerchat server, directly on the shell.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hackerchat": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "check:pack": "node scripts/check-pack.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "chat",
    "websocket",
    "terminal",
    "nodejs",
    "node"
  ],
  "author": {
    "name": "Matheus Sartori",
    "email": "ms.sartori@outlook.com.br",
    "url": "https://github.com/matheussartori"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "figures": "^6.1.0",
    "ink": "^7.1.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "ink-testing-library": "^4.0.0",
    "neostandard": "^0.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
