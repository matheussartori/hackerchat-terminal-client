{
  "name": "@matheussartori/hackerchat-client",
  "version": "2.0.0",
  "description": "The hackerchat client allows you to connect to any hackerchat server, directly on the shell.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hackerchat": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "check:pack": "node scripts/check-pack.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "chat",
    "websocket",
    "terminal",
    "nodejs",
    "node"
  ],
  "author": {
    "name": "Matheus Sartori",
    "email": "ms.sartori@outlook.com.br",
    "url": "https://github.com/matheussartori"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.1",
    "figures": "^6.1.0",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "ink-testing-library": "^4.0.0",
    "neostandard": "^0.14.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@^10": "^11.0.8"
  }
}
